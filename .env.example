# Security AI Configuration Example

# AI Model Configuration
MODEL=llama3.1:8b

# Default target for testing (change as needed)
DEFAULT_TARGET=http://testphp.vulnweb.com

# Scan Configuration
SCAN_TIMEOUT=300
LOG_LEVEL=INFO

# Server Configuration  
HOST=127.0.0.1
PORT=8004

# Docker Configuration
DOCKER_TIMEOUT=300

# Ollama Configuration (for local AI analysis)
OLLAMA_HOST=http://localhost:11434
